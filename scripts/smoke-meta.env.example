# Copier en scripts/smoke-meta.env et renseigner.
# La copie est ignorée par git (motif *.env) ; ce fichier d'exemple, non.
# Ne jamais renseigner de vraie valeur ICI.

SUPABASE_URL=https://zjugauidrijghesgsmap.supabase.co
SUPABASE_ANON_KEY=

# Utilisateur de test, créé depuis Dashboard → Authentication → Add user.
TEST_EMAIL=
TEST_PASSWORD=

# Optionnel : réutiliser un magasin plutôt qu'en créer un.
# STORE_ID=

# Visuel de test.
#
# C'est Meta qui va CHERCHER le fichier, pas nous : l'URL doit être joignable
# depuis les serveurs de Meta, sans authentification, sans redirection. Une URL
# signée Supabase marche, à condition que sa durée de vie couvre l'appel.
#
# Instagram est strict sur le format, et c'est là que ça échoue en pratique :
#   · JPEG uniquement — un PNG est refusé, un WebP aussi
#   · ratio entre 4:5 (portrait) et 1.91:1 (paysage)
#   · 8 Mo maximum
# Facebook accepte beaucoup plus large.
#
# Le plus simple pour tester : Dashboard → Storage → créer un bucket PUBLIC
# « promo-media », y déposer un JPEG carré, et copier son URL publique
#   https://<ref>.supabase.co/storage/v1/object/public/promo-media/<fichier>.jpg
#
# Laisser vide est aussi un test valable : Instagram doit échouer proprement
# avec « Instagram exige un visuel », pendant que Facebook publie quand même.
TEST_MEDIA_URL=
